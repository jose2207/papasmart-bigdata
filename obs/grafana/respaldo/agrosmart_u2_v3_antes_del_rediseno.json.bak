          },
          "format": "table",
          "rawSql": "SELECT humedad_suelo_pct AS \"Humedad volumétrica del suelo\" FROM eventos_telemetria ORDER BY fecha_evento DESC LIMIT 1",
          "editorMode": "code"
        }
      ]
    },
