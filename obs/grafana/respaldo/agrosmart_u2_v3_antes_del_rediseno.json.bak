      "datasource": {
        "type": "postgres",
        "uid": "agrosmart_pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "agrosmart_pg"
          },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(fecha_evento,'1h'), COUNT(*) AS \"Evaluaciones por hora\" FROM eventos_empresariales WHERE $__timeFilter(fecha_evento) GROUP BY 1 ORDER BY 1",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 12,
      "title": "Estado de las evaluaciones de humedad",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "description": "Los estados se basan en un umbral demostrativo; no equivalen a una recomendación agronómica de riego.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "align": "auto",
            "filterable": true,
            "inspect": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "postgres",
        "uid": "agrosmart_pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "agrosmart_pg"
          },
          "format": "table",
          "rawSql": "SELECT estado AS \"Estado de evaluación\", COUNT(*) AS \"Eventos\", ROUND(AVG(humedad_suelo_pct)::numeric,2) AS \"Humedad suelo media (%)\" FROM eventos_empresariales GROUP BY estado ORDER BY \"Eventos\" DESC",
          "editorMode": "code"
        }
      ]
    },
