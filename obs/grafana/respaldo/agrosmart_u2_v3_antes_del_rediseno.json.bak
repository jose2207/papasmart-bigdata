    {
      "id": 308,
      "title": "Historial de ejecuciones integradas (manifiestos registrados)",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 166,
        "w": 24,
        "h": 8
      },
      "description": "Una fila por corrida del cuaderno U3; el manifiesto JSON completo está en la carpeta evidencias.",
      "datasource": {
        "type": "postgres",
        "uid": "agrosmart_pg"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "agrosmart_pg"
          },
          "format": "table",
          "rawSql": "SELECT ejecutado_utc AS \"Fecha\", run_id AS \"Corrida\", estado AS \"Estado\", compuertas_ok||'/'||compuertas_total AS \"Compuertas\", ROUND(duracion_s::numeric,1) AS \"Duración (s)\", ROUND(lat_p50_hum_s::numeric,2) AS \"p50 hum (s)\", ROUND(lat_p95_hum_s::numeric,2) AS \"p95 hum (s)\", ROUND(lat_p50_temp_s::numeric,2) AS \"p50 temp (s)\", ROUND(lat_p95_temp_s::numeric,2) AS \"p95 temp (s)\", ROUND(pred_error_hum_1h::numeric,4) AS \"Error +1h hum\", ROUND(pred_error_temp_1h::numeric,4) AS \"Error +1h temp (°C)\" FROM ejecuciones_integracion ORDER BY ejecutado_utc DESC LIMIT 20",
          "editorMode": "code"
        }
      ]
    }
