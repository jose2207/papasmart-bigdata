        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "agrosmart_pg"
          },
          "format": "time_series",
          "rawSql": "SELECT $__time(fecha_evento), humedad_suelo_pct AS \"Observada · suelo (%)\" FROM eventos_telemetria WHERE $__timeFilter(fecha_evento) ORDER BY fecha_evento",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "postgres",
            "uid": "agrosmart_pg"
          },
          "format": "time_series",
          "rawSql": "SELECT $__time(fecha_objetivo), prediccion_pct AS \"Predicción +1 h (%)\" FROM predicciones_humedad WHERE $__timeFilter(fecha_objetivo) AND horizonte_h=1 ORDER BY fecha_objetivo",
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "postgres",
            "uid": "agrosmart_pg"
          },
          "format": "time_series",
