    {
      "id": 13,
      "title": "Modelos seleccionados · desempeño de prueba",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 12,
        "h": 9
      },
      "description": "Métricas calculadas con división temporal. RMSE/MAE se expresan en puntos porcentuales de humedad volumétrica, no en porcentajes relativos.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "align": "auto",
            "filterable": true,
            "inspect": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "postgres",
        "uid": "agrosmart_pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "agrosmart_pg"
          },
          "format": "table",
          "rawSql": "SELECT horizonte_h AS \"Horizonte (h)\", modelo AS \"Modelo elegido\", ROUND(rmse::numeric,4) AS \"RMSE (pp)\", ROUND(mae::numeric,4) AS \"MAE (pp)\", ROUND(r2::numeric,4) AS \"R²\", ROUND(baseline_rmse::numeric,4) AS \"RMSE persistencia (pp)\", n_prueba AS \"Muestras de prueba\" FROM metricas_modelo ORDER BY horizonte_h",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 25,
      "title": "RMSE de prueba · modelo elegido frente a persistencia",
      "type": "barchart",
      "gridPos": {
        "x": 12,
        "y": 60,
        "w": 12,
        "h": 9
      },
      "description": "Menor RMSE significa menor error. Valores en puntos porcentuales de humedad del suelo. No refleja una validación física independiente de Open-Meteo.",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: pp",
          "decimals": 3,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Modelo elegido · RMSE"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2DD4A4"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Persistencia · RMSE"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FFD166"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "xField": "Horizonte",
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.65,
        "barWidth": 0.8,
        "barRadius": 0,
        "colorByField": "",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": {
        "type": "postgres",
        "uid": "agrosmart_pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "agrosmart_pg"
          },
          "format": "table",
          "rawSql": "SELECT CONCAT(horizonte_h, ' h') AS \"Horizonte\", ROUND(rmse::numeric,4) AS \"Modelo elegido · RMSE\", ROUND(baseline_rmse::numeric,4) AS \"Persistencia · RMSE\" FROM metricas_modelo ORDER BY horizonte_h",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 14,
      "title": "Comparación de los cuatro algoritmos · tres horizontes (12 resultados)",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 69,
        "w": 24,
        "h": 10
      },
      "description": "La elección se determina en el conjunto de validación, no mirando los resultados de prueba.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "align": "auto",
            "filterable": true,
            "inspect": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "postgres",
        "uid": "agrosmart_pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "agrosmart_pg"
          },
          "format": "table",
          "rawSql": "SELECT horizonte_h AS \"Horizonte (h)\", modelo AS \"Algoritmo\", ROUND(rmse_validacion::numeric,4) AS \"RMSE validación (pp)\", ROUND(rmse_prueba::numeric,4) AS \"RMSE prueba (pp)\", ROUND(mae_prueba::numeric,4) AS \"MAE prueba (pp)\", ROUND(r2_prueba::numeric,4) AS \"R² prueba\", CASE WHEN seleccionado THEN 'Sí' ELSE 'No' END AS \"Elegido\" FROM comparacion_modelos ORDER BY horizonte_h,rmse_validacion",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 15,
      "title": "Naturaleza temporal de las predicciones · replay vs prospectivo",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 79,
        "w": 24,
        "h": 7
      },
      "description": "Retrospectiva significa que la predicción se calculó después de su fecha objetivo. No presentarla como pronóstico realizado en vivo.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "align": "auto",
            "filterable": true,
            "inspect": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "postgres",
        "uid": "agrosmart_pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "agrosmart_pg"
          },
          "format": "table",
          "rawSql": "SELECT horizonte_h AS \"Horizonte (h)\", COUNT(*) AS \"Total\", SUM(CASE WHEN es_retro THEN 1 ELSE 0 END) AS \"Retrospectivas\", SUM(CASE WHEN NOT es_retro THEN 1 ELSE 0 END) AS \"Prospectivas\" FROM predicciones_humedad GROUP BY horizonte_h ORDER BY horizonte_h",
          "editorMode": "code"
        }
      ]
    },
