        }
      },
      "datasource": {
        "type": "postgres",
        "uid": "agrosmart_pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "agrosmart_pg"
          },
          "format": "time_series",
          "rawSql": "SELECT $__time(fecha_evento), humedad_aire_pct AS \"Humedad del aire (%)\" FROM eventos_telemetria WHERE $__timeFilter(fecha_evento) ORDER BY fecha_evento",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 23,
      "title": "Cambios entre lecturas consecutivas · suelo (pp)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 7
      },
      "description": "Diferencia en puntos porcentuales entre lecturas consecutivas de la misma ubicación. Puede mostrar cambios sutiles sin distorsionar la escala del nivel de humedad.",
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: pp",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 55,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "Cambio entre lecturas (pp)",
            "axisCenteredZero": true
          },
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cambio del suelo (pp)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2DD4A4"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "datasource": {
        "type": "postgres",
        "uid": "agrosmart_pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "agrosmart_pg"
          },
          "format": "time_series",
          "rawSql": "WITH serie AS (SELECT fecha_evento, humedad_suelo_pct, LAG(humedad_suelo_pct) OVER (PARTITION BY ubicacion ORDER BY fecha_evento) AS humedad_anterior FROM eventos_telemetria WHERE $__timeFilter(fecha_evento)) SELECT $__time(fecha_evento), (humedad_suelo_pct - humedad_anterior) AS \"Cambio del suelo (pp)\" FROM serie WHERE humedad_anterior IS NOT NULL ORDER BY fecha_evento",
          "editorMode": "code"
        }
      ]
    },
