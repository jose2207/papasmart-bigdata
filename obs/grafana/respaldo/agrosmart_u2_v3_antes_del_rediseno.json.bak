    {
      "id": 7,
      "title": "Humedad volumétrica del suelo · 0–1 cm",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "description": "Estimaciones horarias modeladas por Open-Meteo. Un porcentaje volumétrico NO es porcentaje de saturación.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "auto",
            "spanNulls": false,
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisPlacement": "auto",
            "gradientMode": "none",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisLabel": "Humedad volumétrica (%)"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Humedad del suelo (%)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2DD4A4"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "datasource": {
        "type": "postgres",
        "uid": "agrosmart_pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "agrosmart_pg"
          },
          "format": "time_series",
          "rawSql": "SELECT $__time(fecha_evento), humedad_suelo_pct AS \"Humedad del suelo (%)\" FROM eventos_telemetria WHERE $__timeFilter(fecha_evento) ORDER BY fecha_evento",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 8,
      "title": "Humedad relativa del aire · 2 m",
